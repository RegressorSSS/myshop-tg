package usecase

import "myshop/internal/domain"

type ProductUsecase struct {
	repo domain.ProductRepository
}

func NewProductUsecase(r domain.ProductRepository) *ProductUsecase {
	return &ProductUsecase{repo: r}
}

func (u *ProductUsecase) GetProducts() ([]domain.Product, error) {
	return u.repo.GetAll()
}

func (u *ProductUsecase) CreateProduct(p *domain.Product) error {
	// пример бизнес-логики
	if p.Price <= 0 {
		return ErrInvalidPrice
	}

	return u.repo.Create(p)
}
